---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { appProjects, photoProjects } from '../../data/projects';
import type { AppProject, PhotoProject } from '../../data/projects';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const appPaths = appProjects.map(p => ({
    params: { slug: p.slug },
    props: { project: p, type: 'app' as const },
  }));

  const photoPaths = photoProjects.map(p => ({
    params: { slug: p.slug },
    props: { project: p, type: 'photography' as const },
  }));

  return [...appPaths, ...photoPaths];
}

interface Props {
  project: AppProject | PhotoProject;
  type: 'app' | 'photography';
}

const { project, type } = Astro.props;

// Load photo gallery data if it's a photography project
let galleryImages: Array<{ src: string; width: number; height: number; orientation: string }> = [];
if (type === 'photography') {
  try {
    const jsonPath = path.join(process.cwd(), 'src', 'content', 'photography', `${project.slug}.json`);
    const data = JSON.parse(fs.readFileSync(jsonPath, 'utf-8'));
    galleryImages = data.images || [];
  } catch {
    // Gallery data not yet created
  }
}

const appProject = type === 'app' ? project as AppProject : null;
---

<BaseLayout title={`${project.title} - Matt Harrington`}>
  <!-- Back link -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-8">
    <a href="/work" class="inline-flex items-center gap-2 text-sm text-gray-400 hover:text-brand-blue transition-colors">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      Back to Work
    </a>
  </div>

  {type === 'app' && appProject && (
    <article class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
      <!-- App Header -->
      <div class="text-center mb-16">
        <img src={appProject.icon} alt={`${appProject.title} icon`} width="80" height="80" class="mx-auto mb-4 rounded-2xl" />
        <h1 class="text-4xl font-bold mb-2">{appProject.title}</h1>
        <p class="text-lg text-gray-400 mb-6">{appProject.description}</p>
        {appProject.appStoreUrl && (
          <a
            href={appProject.appStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-6 py-3 bg-brand-blue text-white rounded-full font-medium hover:bg-blue-600 transition-colors"
          >
            Download on the App Store
          </a>
        )}
      </div>

      <!-- App Sections -->
      {appProject.sections.map((section, i) => (
        <section class={`py-12 ${i > 0 ? 'border-t border-gray-800' : ''}`} data-animate>
          <div class={`flex flex-col ${i % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'} gap-8 items-center`}>
            <div class="flex-1">
              <h2 class="text-2xl font-bold mb-4">{section.title}</h2>
              <div class="space-y-3">
                {section.paragraphs.map(p => (
                  <p class="text-gray-400 leading-relaxed">{p}</p>
                ))}
              </div>
              {section.title === 'Privacy Policy' && (
                <a
                  href={`mailto:${appProject.feedbackEmail}?subject=${appProject.title} Feedback&body=Hello!`}
                  class="inline-block mt-4 text-brand-blue hover:underline"
                >
                  Send Feedback
                </a>
              )}
            </div>
            <div class="flex-1 flex justify-center">
              {section.video ? (
                <video controls class="rounded-xl max-w-full shadow-lg" preload="none" playsinline>
                  <source src={section.video} type="video/mp4" />
                </video>
              ) : section.image ? (
                <img
                  src={section.image}
                  alt={section.title}
                  loading="lazy"
                  decoding="async"
                  class="rounded-xl max-w-full shadow-lg max-h-96 object-contain"
                />
              ) : null}
            </div>
          </div>
        </section>
      ))}
    </article>
  )}

  {type === 'photography' && (
    <article class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
      <h1 class="text-4xl font-bold text-center mb-12">{project.title}</h1>

      {galleryImages.length > 0 ? (
        <>
          <!-- Masonry Gallery -->
          <div class="columns-1 sm:columns-2 lg:columns-3 xl:columns-4 gap-4" id="gallery">
            {galleryImages.map((img, i) => (
              <button
                class="gallery-item block w-full mb-4 break-inside-avoid cursor-pointer rounded-lg overflow-hidden group"
                data-index={i}
                data-src={img.src}
                aria-label={`View ${project.title} photo ${i + 1}`}
              >
                <img
                  src={img.src}
                  alt={`${project.title} photo ${i + 1}`}
                  width={img.width}
                  height={img.height}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-auto transition-transform duration-300 group-hover:scale-105"
                />
              </button>
            ))}
          </div>

          <!-- Lightbox Modal -->
          <div
            id="lightbox"
            class="fixed inset-0 z-50 bg-black/95 hidden items-center justify-center"
            role="dialog"
            aria-modal="true"
            aria-label="Image viewer"
          >
            <button id="lightbox-close" class="absolute top-4 right-4 z-10 p-2 text-white hover:text-gray-300" aria-label="Close">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
            <button id="lightbox-prev" class="absolute left-4 z-10 p-2 text-white hover:text-gray-300" aria-label="Previous image">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
              </svg>
            </button>
            <button id="lightbox-next" class="absolute right-4 z-10 p-2 text-white hover:text-gray-300" aria-label="Next image">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </button>
            <img id="lightbox-img" src="" alt="" class="max-h-[90vh] max-w-[90vw] object-contain" />
            <div id="lightbox-counter" class="absolute bottom-4 left-1/2 -translate-x-1/2 text-white text-sm"></div>
          </div>
        </>
      ) : (
        <p class="text-center text-gray-500">Gallery loading...</p>
      )}
    </article>
  )}
</BaseLayout>

<script>
  function initLightbox() {
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxCounter = document.getElementById('lightbox-counter');
    const items = document.querySelectorAll('.gallery-item');
    let currentIndex = 0;
    let previousFocus: HTMLElement | null = null;
    const sources: string[] = [];

    items.forEach((item, i) => {
      sources.push((item as HTMLElement).dataset.src || '');
      item.addEventListener('click', () => {
        currentIndex = i;
        previousFocus = document.activeElement as HTMLElement;
        showImage();
        lightbox?.classList.remove('hidden');
        lightbox?.classList.add('flex');
        document.body.style.overflow = 'hidden';
        document.getElementById('lightbox-close')?.focus();
      });
    });

    function showImage() {
      if (lightboxImg && sources[currentIndex]) {
        lightboxImg.src = sources[currentIndex];
        lightboxImg.alt = `Photo ${currentIndex + 1} of ${sources.length}`;
      }
      if (lightboxCounter) {
        lightboxCounter.textContent = `${currentIndex + 1} / ${sources.length}`;
      }
    }

    function closeLightbox() {
      lightbox?.classList.add('hidden');
      lightbox?.classList.remove('flex');
      document.body.style.overflow = '';
      previousFocus?.focus();
    }

    document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
    document.getElementById('lightbox-prev')?.addEventListener('click', () => {
      currentIndex = (currentIndex - 1 + sources.length) % sources.length;
      showImage();
    });
    document.getElementById('lightbox-next')?.addEventListener('click', () => {
      currentIndex = (currentIndex + 1) % sources.length;
      showImage();
    });

    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (e) => {
      if (lightbox?.classList.contains('hidden')) return;
      if (e.key === 'Escape') { closeLightbox(); return; }
      if (e.key === 'ArrowLeft') { currentIndex = (currentIndex - 1 + sources.length) % sources.length; showImage(); return; }
      if (e.key === 'ArrowRight') { currentIndex = (currentIndex + 1) % sources.length; showImage(); return; }
      // Focus trap
      if (e.key === 'Tab') {
        const focusable = lightbox!.querySelectorAll<HTMLElement>('button');
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    // Touch swipe support
    let touchStartX = 0;
    lightbox?.addEventListener('touchstart', (e) => { touchStartX = (e as TouchEvent).changedTouches[0].screenX; });
    lightbox?.addEventListener('touchend', (e) => {
      const diff = (e as TouchEvent).changedTouches[0].screenX - touchStartX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) { currentIndex = (currentIndex - 1 + sources.length) % sources.length; }
        else { currentIndex = (currentIndex + 1) % sources.length; }
        showImage();
      }
    });
  }

  initLightbox();
  document.addEventListener('astro:after-swap', initLightbox);
</script>
