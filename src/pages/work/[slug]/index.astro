---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps.map(app => ({
    params: { slug: app.data.slug },
    props: { app: app.data },
  }));
}

const { app } = Astro.props;
---

<BaseLayout title={`${app.title} - Matt Harrington`}>
  <!-- Back link -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-8">
    <a href="/work" class="inline-flex items-center gap-2 text-sm text-gray-400 hover:text-brand-blue transition-colors">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      Back to Work
    </a>
  </div>

  <article class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <!-- App Header -->
    <div class="text-center mb-16">
      <img src={app.icon} alt={`${app.title} icon`} width="80" height="80" class="mx-auto mb-4 rounded-2xl" />
      <h1 class="text-4xl font-bold mb-2">{app.title}</h1>
      <p class="text-lg text-gray-400 mb-6">{app.description}</p>
      {app.appStoreUrl && (
        <a
          href={app.appStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-6 py-3 bg-brand-blue text-white rounded-full font-medium hover:bg-blue-600 transition-colors"
        >
          Download on the App Store
        </a>
      )}
    </div>

    <!-- App Sections -->
    {app.sections.map((section, i) => (
      <section class={`py-12 ${i > 0 ? 'border-t border-gray-800' : ''}`} data-animate>
        <div class={`flex flex-col ${i % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'} gap-8 items-center`}>
          <div class="flex-1">
            <h2 class="text-2xl font-bold mb-4">{section.title}</h2>
            <div class="space-y-3">
              {section.paragraphs.map(p => (
                <p class="text-gray-400 leading-relaxed">{p}</p>
              ))}
            </div>
            {section.title === 'Privacy Policy' && (
              <a
                href={`mailto:${app.feedbackEmail}?subject=${app.title} Feedback&body=Hello!`}
                class="inline-block mt-4 text-brand-blue hover:underline"
              >
                Send Feedback
              </a>
            )}
          </div>
          <div class="flex-1 flex justify-center">
            {section.video ? (
              <video controls class="rounded-xl max-w-full shadow-lg" preload="none" playsinline>
                <source src={section.video} type="video/mp4" />
              </video>
            ) : section.image ? (
              <img
                src={section.image}
                alt={section.title}
                loading="lazy"
                decoding="async"
                class="rounded-xl max-w-full shadow-lg max-h-96 object-contain"
              />
            ) : null}
          </div>
        </div>
      </section>
    ))}

    <!-- Support Button -->
    <div class="text-center pt-12 border-t border-gray-800 mt-12">
      <a
        href={`/work/${app.slug}/support`}
        class="inline-flex items-center gap-2 px-6 py-3 bg-gray-800 text-white rounded-full font-medium hover:bg-gray-700 transition-colors"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" />
        </svg>
        Support
      </a>
    </div>
  </article>
</BaseLayout>
