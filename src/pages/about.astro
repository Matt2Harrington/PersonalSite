---
import BaseLayout from '../layouts/BaseLayout.astro';
import { aboutParagraphs, myProgressParagraphs, myHobbiesParagraphs } from '../data/about';
import { education } from '../data/education';
import { experiences } from '../data/experience';
import { programmingSkills, technologyEnvironments, technologyExposure } from '../data/technologies';
---

<BaseLayout title="About - Matt Harrington">
  <section class="py-16 px-4 sm:px-6 max-w-4xl mx-auto">
    <!-- Profile Header -->
    <div class="text-center mb-16" data-animate>
      <img
        src="/images/profile/matt-profile2.png"
        alt="Matt Harrington"
        width="160"
        height="160"
        class="rounded-full mx-auto mb-6 object-cover object-top w-36 h-36 ring-4 ring-gray-700"
      />
      <h1 class="text-4xl font-bold mb-2">Matt Harrington</h1>
      <p class="text-lg text-gray-400">iOS Developer &amp; Photographer</p>
    </div>

    <!-- About Tabs -->
    <div class="mb-16" data-animate>
      <div role="tablist" class="flex justify-center gap-1 mb-8 bg-gray-800 rounded-full p-1 max-w-md mx-auto">
        <button role="tab" id="tab-about" data-about-tab="about" aria-selected="true" aria-controls="panel-about" tabindex="0" class="about-tab flex-1 px-4 py-2 rounded-full text-sm font-medium bg-gray-700 shadow-sm text-white">
          About Me
        </button>
        <button role="tab" id="tab-progress" data-about-tab="progress" aria-selected="false" aria-controls="panel-progress" tabindex="-1" class="about-tab flex-1 px-4 py-2 rounded-full text-sm font-medium text-gray-400">
          My Progress
        </button>
        <button role="tab" id="tab-hobbies" data-about-tab="hobbies" aria-selected="false" aria-controls="panel-hobbies" tabindex="-1" class="about-tab flex-1 px-4 py-2 rounded-full text-sm font-medium text-gray-400">
          My Hobbies
        </button>
      </div>

      <div id="panel-about" role="tabpanel" aria-labelledby="tab-about" class="about-panel space-y-4">
        {aboutParagraphs.map(p => <p class="text-gray-400 leading-relaxed">{p}</p>)}
      </div>
      <div id="panel-progress" role="tabpanel" aria-labelledby="tab-progress" class="about-panel space-y-4 hidden">
        {myProgressParagraphs.map(p => <p class="text-gray-400 leading-relaxed">{p}</p>)}
      </div>
      <div id="panel-hobbies" role="tabpanel" aria-labelledby="tab-hobbies" class="about-panel space-y-4 hidden">
        {myHobbiesParagraphs.map(p => <p class="text-gray-400 leading-relaxed">{p}</p>)}
      </div>
    </div>

    <!-- Experience -->
    <div class="mb-16" data-animate>
      <h2 class="text-2xl font-bold mb-8">Experience</h2>
      <div class="space-y-8">
        {experiences.map(exp => (
          <div class="border-l-2 border-brand-blue pl-6">
            <div class="flex items-center justify-between gap-4">
              <h3 class="text-lg font-semibold">{exp.company}</h3>
              <span class="text-sm text-gray-500 whitespace-nowrap">{exp.timeframe}</span>
            </div>
            <p class="text-sm text-brand-blue font-medium mb-2">{exp.title}</p>
            <p class="text-gray-400 leading-relaxed mb-2">{exp.description}</p>
            <p class="text-gray-400 leading-relaxed text-sm">{exp.details}</p>
            {exp.githubUrl && (
              <a href={exp.githubUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 mt-2 text-sm text-brand-blue hover:underline">
                <img src="/images/social/github.png" alt="" width="16" height="16" class="invert" />
                View on GitHub
              </a>
            )}
          </div>
        ))}
      </div>
    </div>

    <!-- Education -->
    <div class="mb-16" data-animate>
      <h2 class="text-2xl font-bold mb-8">Education</h2>
      <div class="bg-gray-900 rounded-xl p-6">
        <div class="flex items-start gap-4 mb-4">
          <img src={education.logo} alt="Francis Marion University" width="48" height="48" class="rounded" />
          <div>
            <h3 class="text-lg font-semibold">{education.institution}</h3>
            <p class="text-gray-400">{education.degree}</p>
            <p class="text-sm text-gray-500">{education.location}</p>
          </div>
        </div>
        <ul class="space-y-2 mt-4">
          {education.achievements.map(a => (
            <li class="flex items-start gap-2 text-gray-400 text-sm">
              <svg class="w-5 h-5 text-brand-blue flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {a}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Technologies -->
    <div data-animate>
      <h2 class="text-2xl font-bold mb-8">Technologies</h2>

      <div class="space-y-8">
        <div>
          <h3 class="text-lg font-semibold mb-3">Programming Skills</h3>
          <div class="flex flex-wrap gap-2">
            {programmingSkills.map(skill => (
              <span class="inline-block px-3 py-1.5 rounded-full bg-brand-blue/20 text-blue-300 text-sm font-medium">
                {skill}
              </span>
            ))}
          </div>
        </div>

        <div>
          <h3 class="text-lg font-semibold mb-3">Environments &amp; Tools</h3>
          <div class="flex flex-wrap gap-2">
            {technologyEnvironments.map(env => (
              <span class="inline-block px-3 py-1.5 rounded-full bg-brand-purple/20 text-purple-300 text-sm font-medium">
                {env}
              </span>
            ))}
          </div>
        </div>

        <div>
          <h3 class="text-lg font-semibold mb-3">What I've Been Learning Lately</h3>
          <div class="flex flex-wrap gap-2">
            {technologyExposure.map(tech => (
              <span class="inline-block px-3 py-1.5 rounded-full bg-brand-red/20 text-red-300 text-sm font-medium">
                {tech}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initAboutTabs() {
    const tabs = Array.from(document.querySelectorAll<HTMLElement>('.about-tab'));
    const panels = document.querySelectorAll('.about-panel');

    function activateTab(tab: HTMLElement) {
      const target = tab.dataset.aboutTab;

      tabs.forEach(t => {
        t.setAttribute('aria-selected', 'false');
        t.setAttribute('tabindex', '-1');
        t.classList.remove('bg-gray-700', 'shadow-sm', 'text-white');
        t.classList.add('text-gray-400');
      });
      tab.setAttribute('aria-selected', 'true');
      tab.setAttribute('tabindex', '0');
      tab.classList.add('bg-gray-700', 'shadow-sm', 'text-white');
      tab.classList.remove('text-gray-400');

      panels.forEach(panel => panel.classList.add('hidden'));
      document.getElementById(`panel-${target}`)?.classList.remove('hidden');
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => activateTab(tab));
      tab.addEventListener('keydown', (e) => {
        const idx = tabs.indexOf(tab);
        let newIdx = idx;
        if (e.key === 'ArrowRight') newIdx = (idx + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') newIdx = (idx - 1 + tabs.length) % tabs.length;
        else return;
        e.preventDefault();
        activateTab(tabs[newIdx]);
        tabs[newIdx].focus();
      });
    });
  }

  initAboutTabs();
  document.addEventListener('astro:after-swap', initAboutTabs);
</script>
