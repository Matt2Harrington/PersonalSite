---
---

<section class="relative h-screen flex items-center justify-center overflow-hidden">
  <video
    autoplay
    muted
    loop
    playsinline
    class="absolute inset-0 w-full h-full object-cover"
    preload="auto"
  >
    <source src="/videos/uploadNYCEmpire.mp4" type="video/mp4" />
  </video>
  <div class="absolute inset-0 bg-black/50"></div>
  <div class="relative z-10 text-center text-white px-4">
    <h1 class="text-5xl md:text-7xl font-cursive mb-4" transition:name="hero-title">
      Matt Harrington
    </h1>
    <p class="text-xl md:text-2xl font-light mb-8 tracking-wide">
      iOS Developer
    </p>
    <a
      href="/work"
      class="inline-block px-8 py-3 border-2 border-white text-white font-medium rounded-full hover:bg-white hover:text-gray-900 transition-all duration-300"
    >
      View My Work
    </a>
  </div>
  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 animate-bounce">
    <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>

<script>
  function playHeroVideo() {
    const video = document.querySelector('section video') as HTMLVideoElement;
    if (video) video.play().catch(() => {});
  }

  playHeroVideo();
  document.addEventListener('astro:after-swap', playHeroVideo);
</script>
